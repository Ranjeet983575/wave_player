{
  "expo": {
    "name": "Wave Player",
    "slug": "wave-player",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "waveplayer",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ranjeet983575.waveplayer",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Wave Player uses access to your videos so you can browse and play them on this device."
      }
    },
    "android": {
      "package": "com.ranjeet983575.waveplayer",
      "blockedPermissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#090B0A",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-video",
        {
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Wave Player to access videos on your device.",
          "granularPermissions": [
            "video"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#090B0A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
